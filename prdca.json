{
  "schema_version": "1.1",
  "framework": {
    "name": "prdca-framework",
    "version": "0.6.0"
  },
  "accountability": {
    "primary_owner": "",
    "primary_ai_family": ""
  },
  "policy": {
    "external_review_allowed": false,
    "require_artifact_hashes": true,
    "preserve_material_dissent": true,
    "model_voting_allowed": false
  },
  "authorization": {
    "standing_execution": true,
    "routine_document_updates": true,
    "non_destructive_commands": true,
    "local_skill_changes": true,
    "destructive_filesystem_or_git": false,
    "external_deploy_or_publish": false
  },
  "value_governance": {
    "wip_limit": 2,
    "direction_review_interval": 4,
    "diminishing_return_stop_after": 2,
    "require_user_workflow_evidence": true
  },
  "paths": {
    "evidence": ".prdca/evidence",
    "reviews": ".prdca/reviews",
    "reports": ".prdca/reports",
    "skills": [],
    "skill_registry": ".prdca/skills/registry.md"
  }
}
