{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "QuotaBar default capability (sponsor window excluded: pure static page, no Tauri API)",
  "windows": ["main", "settings", "tos"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-start-dragging"
  ]
}
